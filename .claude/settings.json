{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && [ ! -d node_modules ]; then npm ci --no-audit --no-fund; fi",
            "timeout": 300,
            "statusMessage": "Installing dependencies"
          }
        ]
      }
    ]
  }
}
