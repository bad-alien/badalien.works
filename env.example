# LLM API Configuration (Unraid Docker Container)
# Required: URL to your LLM server's completion endpoint
LLM_API_URL=http://192.168.x.x:8080/completion

# Optional: Model name (mainly for Ollama, can be omitted for llama.cpp)
LLM_MODEL_NAME=neuraldaredevil

# Optional: Rate limit per IP (requests per minute)
# Default: 30
RATE_LIMIT_MAX=30

# Optional: Global system prompt (if handled by Next.js backend)
# Leave empty if system prompt is controlled by the LLM server
SYSTEM_PROMPT=

# Resend API Key (for contact form)
RESEND_API_KEY=your_resend_api_key_here
