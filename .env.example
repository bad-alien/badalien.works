# Anthropic API — required for live audit runs (Sonnet 4.6)
# Get from: https://console.anthropic.com/
# Without this, the audit runs in stub mode (returns a canned brief)
ANTHROPIC_API_KEY=

# Resend API — required for sending audit and lead emails to r@badalien.works
# Get from: https://resend.com/
RESEND_API_KEY=

# Daily budget cap for Anthropic API spend (default: $10 USD)
# Audit endpoint returns 503 BUDGET_EXCEEDED once this is reached; resets at UTC midnight
# At ~$0.03/audit (Sonnet 4.6 with caching), $10 = ~330 audits/day
AUDIT_DAILY_BUDGET_USD=10

# LLM backend for The Void chat (existing — not used by audit pipeline)
LLM_API_URL=
LLM_MODEL_NAME=closex/neuraldaredevil-8b-abliterated
